class Solution {
    public boolean isSorted(int[] arr) {
        // code here
        return check(arr,0,arr.length-1);
        
    }
    
    public boolean check(int[] arr , int low,int high){
        int len = high-low+1;
        if(len ==1){
            return true;
        }
        if(arr[low]>arr[low+1]){
            return false;
            
        }
        return check(arr,low+1,high);
    }
}
