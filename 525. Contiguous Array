class Solution {
    public int findMaxLength(int[] nums) {
        HashMap<Integer, Integer> map = new HashMap<>();
        int n = nums.length;
        int zero = 0;
        int one = 0;
        int res = 0;
        for (int i = 0; i < n; i++) {
            if (nums[i] == 0) {
                zero++;
            } else {
                one++;
            }

            int diff = zero - one;
            if (diff == 0) {
                res = Math.max(res, i + 1);
            } else {
                if (map.containsKey(diff)) {
                    int len = i - map.get(diff);
                    res = Math.max(res, len);
                } else {
                    map.put(diff, i);
                }
            }
        }

        return res;
    }
}
        
        
    
