class Solution {
    public int kthSmallest(int[] arr, int k) {
        // Code here
        int n = arr.length;
        PriorityQueue <Integer> pq = new PriorityQueue <>(Collections.reverseOrder());
        
        for(int i=0;i<k;i++){
            pq.add(arr[i]);
        }
        for(int i=k;i<n;i++){
            if(arr[i]>=pq.peek()){
                continue;
            }
            else{
                pq.poll();
                pq.add(arr[i]);
            }
        }
        return pq.peek();
        
    }
}
