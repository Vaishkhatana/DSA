class Solution {
    public void bfs(ArrayList<ArrayList<Integer>> adj,int node,boolean [] visited,ArrayList<Integer> res){
        Queue<Integer> q = new LinkedList<>();
        q.add(node);
        visited[node] = true;
        
        while(!q.isEmpty()){
            int newnode = q.peek();
            q.poll();
            res.add(newnode);
            
            for(int i=0;i<adj.get(newnode).size();i++){
                int neighbour = adj.get(newnode).get(i);
                
                if(visited[neighbour] == false){
                    q.add(neighbour);
                    visited[neighbour] = true;
                }
            }
            
        }
    }
    public ArrayList<Integer> bfs(ArrayList<ArrayList<Integer>> adj) {
        int n = adj.size();
        ArrayList<Integer> res = new ArrayList<>();
        boolean [] visited = new boolean[n];
        bfs(adj,0,visited,res);
        return res;
        // code here
        
    }
}
