class Solution {
    public int minMeetingRooms(int[] start, int[] end) {
        // code here
        Arrays.sort(start);
        Arrays.sort(end);
        int i=0;
        int j=0;
        int n = start.length;
        int m = end.length;
        
        int room =  0;
        int res = 0;
        while(i<n&&j<m){
            if(start[i]<end[j]){
                room++;
                res = Math.max(res,room);
                i++;
            }
            else{
                room--;
                j++;
            }
        }
        return res;
    
        
    }
}
