class Solution {
    public ArrayList<Integer> mergeArrays(int[][] mat) {
        // Code here
        int n = mat.length;
        int m = mat[0].length;
        
        class Pair{
            int value;
            int row;
            int col;
            
            Pair(int v,int r,int c){
                value =v;
                row =r;
                col = c;
            }
        }
        
        
        
        PriorityQueue<Pair> pq = new PriorityQueue<>(
            (a,b)->{
                if(a.value!=b.value){
                    return a.value - b.value;
                }
                else if(a.row!=b.row){
                    return a.row - b.row;
                }
                else{
                    return a.col - b.col;
                }
        });
        
        for(int i=0;i<n;i++){
            pq.add(new Pair(mat[i][0],i,0));
        }
        
        ArrayList<Integer> list = new ArrayList<>();
        
        while(!pq.isEmpty()){
            Pair curr = pq.peek();
            pq.poll();
            list.add(curr.value);
            
            int vlaue = curr.value;
            int row = curr.row;
            int col = curr.col;
            
            if(col<m-1){
                pq.add(new Pair(mat[row][col+1],row,col+1));
            }
        }
        
        return list;
            
        
    }
}
