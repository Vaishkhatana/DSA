class Solution {
    public int findCeil(int[] arr, int x) {
        // code here
        int n = arr.length;
        int low = 0;
        int high = n-1;
        int res = -1;
        while(low<=high){
            int guess  = (low+high)/2;
            // if(arr[guess]>=x){
            //     return guess;
            // use guess = low if you want this method. for this not need to initilaize res = -1  jus add return -1 in last.
            // }
            if(arr[guess]<x){
                low = guess+1;
            }
            else{
                res = guess;
                high = guess-1;
            }
        }
        return res;
        
        
    }
}
