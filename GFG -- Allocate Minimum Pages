class Solution {
    
    //helper function
    public boolean findAllo(int[] arr, long guess,int k){
        int nos = 1;
        long page = 0;
        for(int i=0;i<arr.length;i++){
            if(page+arr[i]<=guess){
                page = page+arr[i];
            }
            else{
                nos++;
                page = arr[i];
                if(nos>k){
                    return false;
                }
            }
            
            
        }
        return true;
    }
    public int findPages(int[] arr, int k) {
        // code here
        int n= arr.length;
        if(k>n){
            return -1;
        }
        
        long res = -1;
        long low=arr[0];
        long high=0 ;
        
        for(int i=0;i<n;i++){
            if(arr[i]>low){
                low = arr[i];
            }
            high = high+arr[i];
            
        }
        
        while(low<=high){
            long guess = (low+high)/2;
            boolean helper = findAllo(arr , guess , k);
            if(helper == true){
                res = guess;
                high = guess-1;
            }
            else{
                low = guess+1;
            }
            
        }
        return (int)res;
    }
}
