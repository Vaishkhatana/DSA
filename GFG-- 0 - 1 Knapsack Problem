class Solution {
    public int func(int W,int val[], int wt[], int i, int n, int[][] dp){
        if(i==n){
            return 0;
        }
        if(dp[i][W]!=-1){
            return dp[i][W];
        }
        if(wt[i]>W){
            return dp[i][W] = func(W, val, wt, i+1, n, dp);
        }
        int yes = val[i]+func(W-wt[i], val, wt, i+1, n, dp);
        int no = func(W, val, wt, i+1, n, dp);
        
        return dp[i][W] = Math.max(yes,no);
    }
    public int knapsack(int W, int val[], int wt[]) {
        int n = val.length;
        int[][] dp = new int[n][W+1];
        for(int i=0;i<n;i++){
            for(int j=0;j<W+1;j++){
                dp[i][j] = -1;
            }
        }
        return func(W, val, wt, 0, n, dp);

        
    }
}
